from functools import wraps
from typing import Callable, Any, Optional

def log(filename: Optional[str] = None) -> Callable:
    """Параметризованный декоратор для логирования работы функций."""

    def decorator(func: Callable) -> Callable:
        @wraps(func)
        def wrapper(*args: Any, **kwargs: Any) -> Any:

            func_name = func._name_
            try:
                #Запускаем оригинальную функцию с её аргументами
                result = func(*args, **kwargs)

                #Формируем сообщение об успешном выполнении
                log_message = f"{func_name} ok"

                #Проверяем, куда записывать: в файл или в консоль
                if filename:
                    with open(filename, "a", encoding="utf-8") as f:
                        f.write(log_message + "\n")
                else:
                    print(log_message)
                #Возвращаем результат работы функции
                return result

            except Exception as e:
                log_message = f"{func_name} error: {type(e)._name_}. Inputs: {args}, {kwargs}"

                if filename:
                    with open(filename, "a", encoding="utf-8") as f:
                        f.write(log_message + "\n")
                else:
                    print(log_message)

                raise e

        return wrapper
    return decorator




